# Files and folders listed below are ignored by sf project deploy and sf project retrieve.
package.xml

# LWC configuration files
**/jsconfig.json
**/.eslintrc.json

# LWC Jest
**/__tests__/**

# --- Node.js tooling (local only, never deployed to an org) ---
node_modules/

# --- Access is managed with permission sets, not profiles ---
# Creating fields in Setup quietly edits profiles; keep those changes out of the project.
**/profiles/**

# --- Org-generated noise (not part of this project) ---
# Experience Cloud content the scratch org changes on its own.
**/digitalExperiences/**